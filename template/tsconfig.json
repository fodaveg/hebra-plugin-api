{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "paths": {
      "hebra-plugin-api": ["../src/index.ts"],
      "hebra-plugin-api/*": ["../src/*.ts"]
    }
  },
  "include": ["src"]
}
